# Interfaces (để "auto" để tự động phát hiện, hoặc điền tên cụ thể như wlan0, eth0)
WIFI_IFACE=auto
ETH_IFACE=auto

# Cấu hình WiFi
WIFI_SSID=matinhieu
WIFI_PASSWORD=88888888
WIFI_HIDDEN=0

# Kênh & Băng tần (WIFI_BAND: auto | 2.4ghz | 5ghz, WIFI_CHANNEL: auto | 1..165)
WIFI_BAND=auto
WIFI_CHANNEL=auto
COUNTRY_CODE=US

# Cấu hình mạng LAN & DHCP
AP_IP=192.168.50.1
AP_SUBNET=192.168.50.0/24
DHCP_START=192.168.50.10
DHCP_END=192.168.50.100
DHCP_LEASE=12h

